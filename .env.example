# Configuración de Notiux Médica local

HOST=127.0.0.1
PORT=3000

# Opción 1: Google Gemini (Recomendado, rápido y de gran contexto)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=45000

# Configure orígenes exactos sólo si el frontend se servirá desde otro host.
# CORS_ORIGINS=https://app.ejemplo.com

# Opción 2: OpenAI / DeepSeek / Groq (Compatible con cualquier proveedor OpenAI)
# OPENAI_API_KEY=tu_openai_o_groq_api_key_aqui
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
